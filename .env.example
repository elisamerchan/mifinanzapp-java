# ============================================
# Mi FinanzApp — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores:
#   cp .env.example .env
# ============================================

# Base de datos PostgreSQL (Neon.tech / Supabase)
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USER=<usuario>
DB_PASSWORD=<contraseña>

# Usuario demo con 6 meses de datos; solo desarrollo, nunca en produccion
# APP_DEMO=true

<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño común de las pantallas de lista (movimientos, categorías, presupuestos, recordatorios) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/lista_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primario"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lista_subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_suave"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/lista_boton_nuevo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/primario"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/lista_boton_alterno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primario_oscuro"
            android:textColor="@android:color/white"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/lista_vacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/lista_vacia"
            android:textColor="@color/texto_suave"
            android:textSize="16sp" />
    </FrameLayout>
</LinearLayout>
